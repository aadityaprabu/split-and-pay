# Node.js and Yarn
# Ignore all node_modules directories
node_modules/

# Yarn 4: commit the pinned release (.yarn/releases), ignore its install state and caches
**/.yarn/*
!**/.yarn/releases
**/.pnp.*

# Ignore .env files everywhere
.env
.env.local

# Ignore common build and output directories
# for frontend and backend
dist/
build/
coverage/

# Vscode and editor files
.vscode/
.DS_Store

# Log files
*.log
