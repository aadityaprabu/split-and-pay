# Template: the nginx image fills in ${FRONTEND_PORT}, ${BACKEND_URL} and ${BACKEND_PORT} from the
# container's environment at startup (envsubst). nginx's own $variables are left alone because
# no environment variables with those names exist.

# Requests reach nginx through a proxy (Coolify's Traefik on the VPS, Docker's port forwarding locally),
# so $remote_addr is the proxy's address. Take the client's IP from X-Forwarded-For instead, but only
# when the request comes from a private (Docker) address, so nobody on the internet can fake it.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from fc00::/7;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# At most 10 API requests a second per client IP (bursts of 20 are let through), so one misbehaving
# tab or script can't flood the backend. Static files aren't limited.
limit_req_zone $binary_remote_addr zone=backend_limit:10m rate=10r/s;
limit_req_status 429;

# Coolify's proxy terminates HTTPS, so nginx itself only ever sees http. Pass on the scheme the browser
# actually used when the proxy tells us, and fall back to our own when there's no proxy (local docker).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

server {
    listen ${FRONTEND_PORT};
    listen [::]:${FRONTEND_PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    # Gzip Compression (gzip_proxied: also compress when the request came through a proxy)
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_vary on;

    # Vite fingerprints everything in /assets, so it can be cached forever
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /healthz {
        add_header Content-Type text/plain;
        return 200 'OK';
    }

    # ${BACKEND_URL}/<route> → backend /api/<route>
    location ${BACKEND_URL}/ {
        limit_req zone=backend_limit burst=20 nodelay;

        proxy_pass http://backend:${BACKEND_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # SPA fallback; index.html itself must never be cached or users get stale bundles
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
